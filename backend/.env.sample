PORT=3000

# MongoDB Database Configuration (Local or Cloud Atlas)
# 1. Local MongoDB:
MONGODB_URI="mongodb://localhost:27017/library_management_db"
# 2. Cloud MongoDB Atlas:
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/library_management_db?retryWrites=true&w=majority"

DATABASE_URL="mongodb://localhost:27017/library_management_db"

# Owner credentials configuration
OWNER_EMAILS=admin@admin.com,owner@gmail.com,admin100@admin.com,admin200@admin.com
DEFAULT_OWNER_PASSWORD=Password123!
JWT_SECRET=your_jwt_secret_here

# Razorpay — get from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=your_email_from_here
